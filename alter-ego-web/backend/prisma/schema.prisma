// Prisma Schema - Alter Ego Esports
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User Model ───────────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  MEMBER
  ADMIN
}

// ─── Roster Player Model ──────────────────────────────────────
model RosterPlayer {
  id       Int    @id @default(autoincrement())
  name     String
  role     String // e.g. "Jungler", "IGL", "Rifler"
  game     Game
  imageUrl String
  bio      String @db.Text
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  @@map("roster_players")
}

enum Game {
  MLBB
  VALORANT
  CS2
}

// ─── News Model ───────────────────────────────────────────────
model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  imageUrl  String
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news")
}

// ─── Brand Ambassador Photo Model ────────────────────────────
model BAPhoto {
  id       Int    @id @default(autoincrement())
  name     String
  imageUrl String
  caption  String
  product  String
  createdAt DateTime @default(now())

  @@map("ba_photos")
}

// ─── Collab Submission Model ──────────────────────────────────
model CollabSubmission {
  id          Int           @id @default(autoincrement())
  brandName   String
  email       String
  collabType  CollabType
  message     String        @db.Text
  status      SubmitStatus  @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("collab_submissions")
}

enum CollabType {
  SPONSORSHIP
  CONTENT_CREATION
  PRODUCT_COLLAB
  EVENT_PARTNERSHIP
  OTHER
}

enum SubmitStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}
